# Copy to .env and fill in. Every key is validated at startup (src/config/env.ts).

NODE_ENV=development
PORT=4000

# Postgres. docker-compose.yml starts one matching this URL.
DATABASE_URL=postgresql://karevo:karevo@localhost:5432/karevo?schema=public

# Comma-separated dashboard origins allowed by CORS and the refresh-endpoint Origin check.
CORS_ORIGINS=http://localhost:5173

# Set to 1 (or a hop count) when running behind a reverse proxy, so req.ip is the client IP.
TRUST_PROXY=0

# Access token signing secret: at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# false only for local http development; must be true anywhere served over HTTPS.
COOKIE_SECURE=false

# AES-256-GCM key for NIN, linked-ID numbers and record details at rest: 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# HMAC key for lookup hashes (NIN uniqueness, share token codes): 32 bytes, base64.
BLIND_INDEX_KEY=

# NIN verification provider. "stub" marks every pending NIN verified (development only).
NIN_PROVIDER=stub
